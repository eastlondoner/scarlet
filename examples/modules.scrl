// Modules. Every file is a module; import pulls another one in. A relative
// path (./ or ../) resolves against this file's own directory, not the cwd.

import scarlet/array
import scarlet/result
import ./lib/report/table
import ./lib/units as units
import ./lib/units.{ABSOLUTE_ZERO_C, Celsius, celsius as c}

fn conversions(t Celsius) Array(String) {
	fahrenheit = units.show_fahrenheit(units.to_fahrenheit(t))
	// Kelvin is opaque: its constructor stays inside units, so to_kelvin is
	// the only way in, and it can fail.
	kelvin = result.map(units.to_kelvin(t), units.show_kelvin) or why -> 'no Kelvin (${why})'
	[fahrenheit, kelvin]
}

pub fn main() {
	// units. holds the whole module; the second import also pulls Celsius,
	// ABSOLUTE_ZERO_C, and celsius (renamed c) into scope.
	readings = [c(-40.0), c(0.0), c(21.5), c(100.0), c(-300.0)]

	println('absolute zero: ${ABSOLUTE_ZERO_C}C')

	// units.round1 is not exported, so the caller cannot reach past the API.
	array.each(readings, fn(t) println(table.row(t, conversions(t))))
}
